# ============================================================
# E-WASTE AI — Environment Variables Template
# Copy to .env and fill in your values
# ============================================================

# Application
APP_ENV=development
APP_DEBUG=false
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=8501

# Database
DATABASE_URL=sqlite:///./database/ewaste_ai.db

# MLflow (optional)
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=ewaste-ai-experiments

# Logging
LOG_LEVEL=INFO
